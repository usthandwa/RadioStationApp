{
  "name": "cms-server",
  "version": "1.0.0",
  "description": "Local CMS API Server for AWR SID Media",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "nodemon --watch . --ext ts --exec ts-node server.ts",
    "build": "tsc",
    "serve": "node dist/server.js"
  },
  "keywords": ["cms", "api", "express"],
  "author": "AWR SID Media",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2"
  }
}
